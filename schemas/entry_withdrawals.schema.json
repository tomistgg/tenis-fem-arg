{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entry list withdrawal history",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["withdrawals", "last_seen"],
    "properties": {
      "withdrawals": {
        "type": "array",
        "items": {
          "allOf": [
            {"$ref": "#/$defs/player"},
            {"required": ["date"], "properties": {"date": {"type": "string", "format": "date"}}}
          ]
        }
      },
      "last_seen": {"type": "object", "additionalProperties": {"$ref": "#/$defs/player"}},
      "last_checked_date": {"type": "string", "format": "date"}
    }
  },
  "$defs": {
    "player": {
      "type": "object",
      "required": ["player_id", "name", "country", "pos", "type"],
      "properties": {
        "player_id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "country": {"type": "string"},
        "pos": {"type": "string"},
        "type": {"enum": ["MAIN", "QUAL", "ALT", ""]},
        "rank": {"type": "string"}
      }
    }
  }
}
