{
  "name": "WTARG",
  "short_name": "WTARG",
  "description": "Women's Tennis Argentina: entry lists, rankings, points, schedules, draws and results.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#093366",
  "theme_color": "#093366",
  "categories": ["sports", "news"],
  "shortcuts": [
    {
      "name": "Entry Lists",
      "short_name": "Entries",
      "url": "./entrylists/",
      "icons": [{ "src": "assets/favicon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Points Breakdown",
      "short_name": "Points",
      "url": "./roadtogs/",
      "icons": [{ "src": "assets/favicon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "url": "./calendar/",
      "icons": [{ "src": "assets/favicon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Schedule",
      "short_name": "Schedule",
      "url": "./upcoming/",
      "icons": [{ "src": "assets/favicon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    {
      "src": "assets/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "assets/favicon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "assets/favicon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
